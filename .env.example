# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CONTACT FORM DELIVERY CONFIGURATION (Optional)
# Configure RESEND_API_KEY and CONTACT_TO_EMAIL to deliver contact form submissions via Resend email API,
# or configure CONTACT_WEBHOOK_URL (e.g. Formspree, Slack, Discord, Make, or custom webhook) to forward messages.
# If neither is set, messages are stored locally in data/messages.json and the UI transparently reports local storage mode.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL="onboarding@resend.dev"
CONTACT_WEBHOOK_URL=""

